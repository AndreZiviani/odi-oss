# A row that names a source address (SSM). An IGMPv3 record that names
# sources is held to it: INCLUDE needs the row's source among them, EXCLUDE
# needs it not among them. A v2 report cannot name a source and goes in on
# the group alone, as does every join of a row with no source.
0 policy
snooping=1
igmp_function=0
immediate_leave=1
allow=232.1.0.0-232.1.255.255 s=10.0.0.5
allow=225.0.0.0-225.255.255.255
end
0 tick
1 v3src incl 1 0 192.168.1.10 232.1.1.1 10.0.0.5
2 v3src incl 1 0 192.168.1.10 232.1.1.2 10.0.0.9
3 v3src excl 1 0 192.168.1.10 232.1.1.3 10.0.0.5
4 v3src excl 1 0 192.168.1.10 232.1.1.4 10.0.0.9
5 v2join 1 0 192.168.1.10 232.1.1.5
6 v3src incl 1 0 192.168.1.10 225.1.1.1 10.0.0.9
7 state
