# Upstream IGMP tag control 1 (G.988 9.3.27 attribute 5), TCI 0xa1a4
# (priority 5, VID 420), joins outside the list discarded (attribute 15 = 0).
# The reports are taken from the start, and each message goes up with the
# profile's tag in front of whatever it had: an untagged join, a join tagged
# VID 10, and a leave. A join outside the list is withheld, and a query from
# the host side is not sent at all.
0 policy
snooping=1
igmp_function=0
immediate_leave=1
unauthorized_join=0
us_tag_control=1
us_tci=41380
us_rate=0
allow=225.0.0.0-225.255.255.255
end
0 tick
1 v2join 1 0 192.168.1.10 225.1.1.1
2 v2join 1 10 192.168.1.10 225.2.2.2
3 v2join 1 0 192.168.1.10 239.1.1.1
4 v3join 1 0 192.168.1.10 239.1.1.2
5 v2leave 1 0 192.168.1.10 225.1.1.1
6 query 1 0 192.168.1.1
7 state
8 status
