# The groups that must always flood, both ways: all nodes (ff02::1, router
# advertisements), all routers (ff02::2), DHCPv6 (ff02::1:2), MLDv2 itself
# (ff02::16), mDNS (ff02::fb), a solicited-node group of neighbour discovery
# (ff02::1:ffxx:xxxx) and any other link-local scope (ff12::). The profile's
# IPv6 list names none of them and the PON's IPv6 drop is on (-d, after the
# learning interval): still none is kept, refused or given a row, and the
# lease says the switch floods ff02::/16 and the solicited-node groups
# whatever the drop says. A group the list names is snooped beside them.
0 policy
snooping=1
igmp_function=0
immediate_leave=1
unauthorized_join=1
query_interval=10
query_max_response=1
allow6=ff3e::8000:0-ff3e::8000:ffff
end
0 tick
1 mld1join 1 0 fe80::2 ff02::1:ff00:1234
2 mld1join 1 0 fe80::2 ff02::1:2
3 mld2join 1 0 fe80::2 ff02::fb
4 mld2join 1 0 fe80::2 ff02::16
5 mld1join 1 0 fe80::2 ff02::2
6 mld1join 1 0 fe80::2 ff02::1
7 mld1join 1 0 fe80::2 ff12::8000:1
8 mld1done 1 0 fe80::2 ff02::1:2
9 mld1join 1 0 fe80::2 ff3e::8000:7
21 tick
22 mld2join 1 0 fe80::2 ff02::1:ff00:1234
23 mld1join 1 0 fe80::2 ff3e::8000:7
24 state
