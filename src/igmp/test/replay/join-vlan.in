# Rows that name a VLAN (ME 309 access control list, VLAN ID (ANI)) keep
# their ranges apart. Upstream tag control 1 puts VID 100 on every IGMP
# message, so every join here is on VLAN 100, which one row names. A group
# of the row for VLAN 100 goes in; a group of the row for VLAN 200 is a stream
# of another VLAN and is refused (withheld from the OLT too); a group of a row
# that names no VLAN goes in as it always did.
0 policy
snooping=1
igmp_function=0
immediate_leave=1
us_tag_control=1
us_tci=100
allow=225.1.0.0-225.1.255.255 v=100
allow=225.2.0.0-225.2.255.255 v=200
allow=225.3.0.0-225.3.255.255
end
0 tick
1 v2join 1 0 192.168.1.10 225.1.1.1
2 v2join 1 0 192.168.1.10 225.2.1.1
3 v2join 1 0 192.168.1.10 225.3.1.1
4 state
