? gpon get => 3: [gpon get onu-state] [gpon get alarm-status] [gpon get flows]
? register get  => 1: [register get <address> <words>]
? nothing => 0:
l2-table get all => [l2-table get all]
l2-table get entry address valid => [l2-table get entry address valid]
l2-table g e a v => [l2-table get entry address valid]
l2-table get index 0x3ff => [l2-table get index <index>] u0=0x3ff
l2-table get index => Incomplete command
l2-table get => Incomplete command
? l2-table => 3: [l2-table get all] [l2-table get entry address valid] [l2-table get index <index>]
? l2-table get e => 1: [l2-table get entry address valid]
