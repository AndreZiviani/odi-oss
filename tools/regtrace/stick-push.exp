set timeout 300
set user [lindex $argv 0]
set pw [lindex $argv 1]
set src [lindex $argv 2]
set dst [lindex $argv 3]
set host [lindex $argv 4]
spawn sh -c "ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR $user@$host 'cat > $dst' < $src"
expect {
    -re "(?i)password:" { send "$pw\r"; exp_continue }
    eof {}
    timeout { puts "TIMEOUT"; exit 1 }
}
