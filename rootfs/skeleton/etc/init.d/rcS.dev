# shellcheck shell=sh
#
# /etc/init.d/rcS.dev -- the development aids of the boot, sourced by both
# rcS (sysinit) and rcS.pon (the PON steps, once rcS returns; docs/BOOT.md)
# -- it ships in the image. Each is off unless its file is on the config
# partition, set by hand on a running stick before a trial:
#
#   breadcrumbs.on  one timestamped line per stage appended to
#                   /etc/config/breadcrumbs, a network snapshot in
#                   /etc/config/trial-diag.txt, the SerDes and PON registers,
#                   a 30 s heartbeat to the kernel log, lower lockup
#                   thresholds
#   confirm-arp     confirm the watchdog only after an ARP reply from the .2
#                   address of br0; a trial that comes up unreachable then
#                   reverts by itself, with its ramlog
#   pon-steps       a PON step list that replaces the built-in one
#
# The config partition is shared and fwu.sh never writes it, so what these
# leave there is readable from the image the stick reverts to. Nothing here
# may block the boot or fail under set -e: every diagnostic runs guarded,
# the slow ones in the background under timeout. docs/BOOT.md has more.

BREADCRUMBS=/etc/config/breadcrumbs

crumb() {
	kmsg "$*"
	if [ -f /etc/config/breadcrumbs.on ]; then
		echo "$(cut -d" " -f1 /proc/uptime) $*" >> "$BREADCRUMBS" 2>/dev/null || true
		sync
	fi
}

# The .2 of the br0 subnet, the fixed test host; empty with no address.
GW=""
dev_gw() {
	if [ -z "$GW" ]; then
		brip=$(ifconfig br0 2>/dev/null | sed -n "s/.*inet addr:\([0-9.]*\).*/\1/p")
		if [ -n "$brip" ]; then
			GW="${brip%.*}.2"
		fi
	fi
}

# Registers through diag, one line, for a crumb.
dev_regs() {
	printf "%s" "$1" | timeout 10 /bin/diag 2>/dev/null | sed -n "s/^\(0x[0-9a-f]*\) *\(0x[0-9a-f]*\).*/\1=\2/p" | tr "\n" " "
}

dev_hook() {
	case $1 in
	config)
		# Truncated at every boot; about 300 bytes.
		if [ -f /etc/config/breadcrumbs.on ]; then
			: > "$BREADCRUMBS" 2>/dev/null || true
		fi
		;;
	network)
		# The host SerDes as network.sh left it: HOST_SERDES_MODE 0x214
		# (Fiber 1G 0x00260004), PHY_PATCH_STATUS 0x110 (bit 0: patch
		# done), PON_SERDES_MODE 0x1d0; and the eth0 interrupt count, 0
		# when nothing from the host reaches the MAC.
		if [ -f /etc/config/breadcrumbs.on ] && [ -x /bin/diag ]; then
			regs=$(dev_regs "register get 0x214 1
register get 0x110 1
register get 0x1d0 1
")
			crumb "sds: ${regs:-diag gave nothing}; eth0 irq $(awk "/eth0/{print \$2}" /proc/interrupts 2>/dev/null)"
		fi
		;;
	services)
		dev_services
		;;
	pon)
		# PON_SERDES_MODE 0x1d0 (8: GPON), DSF_ONU_STATE 0x701010 (ONU
		# state and id), DSF_LOS_SETUP 0x701040 (is there light at all).
		if [ -f /etc/config/breadcrumbs.on ] && [ -x /bin/diag ]; then
			crumb "pon registers: $(dev_regs "register get 0x1d0 1
register get 0x701010 1
register get 0x701040 1
")"
		fi
		;;
	esac
}

dev_services() {
	if [ -f /etc/config/breadcrumbs.on ]; then
		# The soft-lockup default (60 s) is later than the hardware
		# watchdog (42 s after the last kick), so it would never speak.
		[ -w /proc/sys/kernel/softlockup_thresh ] && echo 20 > /proc/sys/kernel/softlockup_thresh
		[ -w /proc/sys/kernel/hung_task_timeout_secs ] && echo 30 > /proc/sys/kernel/hung_task_timeout_secs
		# Uptime, free memory and load every 30 s: it puts a time on
		# "userland stopped" in the ramlog.
		if [ -w /dev/kmsg ]; then
			(
				while :; do
					echo "rcS: alive $(cut -d" " -f1 /proc/uptime) s, free $(awk "/MemFree/{print \$2}" /proc/meminfo) kB, load $(cut -d" " -f1-3 /proc/loadavg)" > /dev/kmsg 2>/dev/null
					sleep 30
				done
			) &
		fi
		dev_trial_diag &
	fi
	# Also when the config partition did not mount: then this is the
	# only diagnostic the boot gets, and printk the only channel left.
	if { [ -f /etc/config/breadcrumbs.on ] || ! config_mounted; } && [ -w /dev/kmsg ]; then
		dev_klog_diag &
	fi
}

# The network from the inside, on the config partition. One section per
# write, synced, each under timeout, so a read that blocks costs only its
# own section. No diag here: a diag ioctl can block where timeout cannot
# end it.
dev_trial_diag() {
	sleep 3
	dev_gw
	d=/etc/config/trial-diag.txt
	sec() { { echo "== $1"; shift; timeout 5 "$@" 2>&1; } >> "$d"; sync; }
	: > "$d"
	sec "$(cut -d" " -f1 /proc/uptime) trial-diag $(cat /etc/version 2>/dev/null)" true
	sec "ifconfig -a" ifconfig -a
	sec "brctl show" brctl show
	sec "brctl showmacs br0" brctl showmacs br0
	sec "ip -s link" ip -s link
	sec "interrupts" cat /proc/interrupts
	sec "net/dev" cat /proc/net/dev
	sec "arp" cat /proc/net/arp
	if [ -n "$GW" ]; then
		sec "arping $GW" arping -c 3 -w 6 -I br0 "$GW"
	fi
	sec "services.log" cat /var/log/services.log
	sec "dmesg" sh -c "dmesg | tail -n 90"
}

# The same questions, to the kernel log.
dev_klog_diag() {
	klog() { echo "rcS diag: $*" > /dev/kmsg 2>/dev/null; }
	dev_gw
	klog "br0 $(timeout 5 ifconfig br0 2>/dev/null | sed -n "s/.*inet addr:\([0-9.]*\).*/\1/p")"
	klog "config: mounted=$(config_mounted && echo yes || echo no) $(timeout 5 grep -c "" /proc/mounts 2>/dev/null) mounts, $(timeout 5 ls /etc/config 2>/dev/null | grep -c "") entries, breadcrumbs.on $([ -f /etc/config/breadcrumbs.on ] && echo present || echo absent)"
	klog "config: $(timeout 5 grep " /var/config " /proc/mounts 2>/dev/null)"
	timeout 5 tail -n 6 /tmp/mount-a.trace 2>/dev/null | while read -r line; do klog "mount -a: $line"; done
	timeout 5 tail -n 6 /tmp/mount-config.trace 2>/dev/null | while read -r line; do klog "trace: $line"; done
	timeout 5 grep " 26:\| 8:" /proc/interrupts 2>/dev/null | while read -r line; do
		klog "irq: $line"
	done
	timeout 5 grep "eth0:\|eth0\.2:" /proc/net/dev 2>/dev/null | while read -r line; do
		klog "net/dev: $line"
	done
	if [ -n "$GW" ]; then
		if timeout 5 arping -c 1 -w 2 -I br0 "$GW" >/dev/null 2>&1; then
			rc=0
		else
			rc=$?
		fi
		klog "arping $GW exit $rc"
	else
		klog "arping: no GW"
	fi
	timeout 5 ip -s link show eth0 2>/dev/null | awk '/RX:|TX:/{print; getline; print}' | while read -r line; do
		klog "eth0: $line"
	done
}

# confirm-arp: never leave it on a stick whose host is not on .2, or every
# boot resets at 120 s.
dev_confirm_ok() {
	[ -f /etc/config/confirm-arp ] || return 0
	dev_gw
	if [ -n "$GW" ] && arping -c 1 -w 2 -I br0 "$GW" >/dev/null 2>&1; then
		crumb "reachable: $GW answered arping (confirm-arp)"
		return 0
	fi
	echo "rcS: confirm-arp set and no ARP reply from ${GW:-<no address>}, not confirming to the watchdog" >&2
	crumb "unreachable: no ARP reply from ${GW:-<no address>}, watchdog NOT confirmed (confirm-arp)"
	return 1
}

# /etc/config/pon-steps: one step per line, a /proc/odi_init verb with its
# argument, or one of four words: omcimods (the switch init, now -- since
# omcid itself starts as its own inittab respawn entry, not from here),
# "gponsn auto" and "gponpw auto" (the values from the config store), and
# gponact (waits for the omcid odi_omci registration first, bounded --
# rcs-lib.sh, pon_step_gponact -- same as the built-in list). A wrong list
# means no PON.
pon_steps() {
	if [ ! -s /etc/config/pon-steps ]; then
		pon_steps_default
		return 0
	fi
	crumb "pon steps from /etc/config/pon-steps"
	while read -r step; do
		case $step in
		'') ;;
		omcimods) omci_start; confirm_watchdog ;;
		"gponsn auto") pon_step_gponsn ;;
		"gponpw auto") pon_step_gponpw ;;
		gponact) pon_step_gponact ;;
		*) pon_step "$step" ;;
		esac
	done < /etc/config/pon-steps
}
