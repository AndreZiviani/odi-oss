#!/bin/sh
#
# OUR config accessor. NOT the vendor script of the same name.
#
# The path is fixed: confd has this path compiled in and execve()s it. The
# vendor file at this path is a
# 251-line wrapper around /bin/xmlconfig, a binary we do not ship and do not
# copy. This is a reimplementation of the four invocations confd actually
# makes, working directly on the XML in /var/config:
#
#     flash all cs          dump the CS table
#     flash all hs          dump the HS table
#     flash set KEY VALUE   set one key, echo KEY=VALUE
#     flash default cs      merge /etc/config_default.xml into CS
#
# It also implements `get KEY`, which the vendor has and our own boot scripts
# can use rather than each carrying its own sed.
#
# WHY THIS IS SOUND HERE AND WOULD NOT BE ON THE VENDOR IMAGE. There, the XML
# is a serialisation of a live MIB that xmlconfig owns and configd, omci_app
# and mib all read; editing the file behind their backs would desynchronise
# them. On this image nothing holds that MIB -- the only readers of the config
# store are network.sh, which parses the XML directly, and confd. So here the
# file IS the configuration.
#
# ODI-ONLY KEYS. SYSLOG_SERVER and NTP_SERVER exist only on this image: the
# stock lastgood*.xml has never carried them, and this script only edits keys
# that are already in those files, so a set on them failed ("no such key") and
# a get printed "GET fail.". They live in a plain KEY=value file on the config
# partition instead, /var/config/odi.conf (= /etc/config/odi.conf). The stock
# firmware ignores that file, and every stock key keeps going to the XML
# exactly as before. Add a name to ODI_KEYS below to add a key; the list is
# documented in docs/SETTINGS.md. An empty value REMOVES the key, which is how
# one is cleared. A line that is not KEY=value is left alone and never read.
#
# /var/config is jffs2 and read-write. Writes go to a temporary file and are
# renamed over the target, so a power cut leaves the old file intact rather
# than a half-written one.
set -u

CS=${CS:-/var/config/lastgood.xml}
HS=${HS:-/var/config/lastgood_hs.xml}
DEFAULTS=${DEFAULTS:-/etc/config_default.xml}
TMPDIR_=${TMPDIR_:-/var/tmp}
ODI_CONF=${ODI_CONF:-/var/config/odi.conf}
ODI_KEYS="SYSLOG_SERVER NTP_SERVER"

usage() {
	echo "usage: flash all {cs|hs}" >&2
	echo "       flash get KEY" >&2
	echo "       flash set KEY VALUE" >&2
	echo "       flash default cs" >&2
	exit 1
}

# One key, from whichever file carries it. The closing quote anchors the match,
# so ELAN_MAC_ADDR cannot be satisfied by ELAN_MAC_ADDR2.
value_of() {
	sed -n "s/.*Name=\"$1\" Value=\"\([^\"]*\)\".*/\1/p" "$2" 2>/dev/null | head -n 1
}

is_odi_key() {
	for k_ in $ODI_KEYS; do [ "$k_" = "$1" ] && return 0; done
	return 1
}

# The key is a validated name from ODI_KEYS, so it is safe inside the pattern.
odi_value_of() {
	sed -n "s/^$1=\(.*\)\$/\1/p" "$ODI_CONF" 2>/dev/null | head -n 1
}

# The odi keys that hold a value, as XML lines in the shape of the stock ones,
# so confd (which parses `flash all cs` by that shape) sees them.
odi_xml() {
	for k_ in $ODI_KEYS; do
		v_=$(odi_value_of "$k_")
		[ -n "$v_" ] && printf '\t\t<Value Name="%s" Value="%s"/>\n' "$k_" "$v_"
	done
	return 0
}

has_key() {
	grep -q "Name=\"$1\" Value=" "$2" 2>/dev/null
}

[ $# -ge 1 ] || usage

case "$1" in
all)
	[ $# -eq 2 ] || usage
	case "$2" in
	cs) f=$CS ;;
	hs) f=$HS ;;
	*)  usage ;;
	esac
	if [ ! -f "$f" ]; then
		echo "flash: $f is not there -- is the config partition mounted?" >&2
		exit 1
	fi
	if [ "$2" = cs ]; then
		last=$(tail -n 1 "$f")
		case "$last" in
		"</"*) sed '$d' "$f"; odi_xml; printf '%s\n' "$last" ;;
		*)     cat "$f"; odi_xml ;;
		esac
	else
		cat "$f"
	fi
	;;

get)
	[ $# -eq 2 ] || usage
	if is_odi_key "$2"; then
		v=$(odi_value_of "$2")
		[ -n "$v" ] && { printf '%s=%s\n' "$2" "$v"; exit 0; }
		echo "GET fail." >&2
		exit 1
	fi
	for f in "$CS" "$HS"; do
		if has_key "$2" "$f"; then
			printf '%s=%s\n' "$2" "$(value_of "$2" "$f")"
			exit 0
		fi
	done
	echo "GET fail." >&2
	exit 1
	;;

set)
	[ $# -eq 3 ] || usage
	key=$2
	val=$3
	# A key is a name, not a pattern: anything else would be interpreted by
	# the sed below and could rewrite lines it was never meant to touch.
	case "$key" in
	*[!A-Za-z0-9_]*|"") echo "flash: refusing key \"$key\"" >&2; exit 1 ;;
	esac
	# The value lands inside an XML attribute delimited by double quotes.
	# Rejecting the three characters that would break out is honest; quietly
	# escaping them would store something the operator did not type.
	case "$val" in
	*[\"\<\&]*) echo "flash: value may not contain a quote, < or &" >&2; exit 1 ;;
	*"
"*) echo "flash: value may not contain a newline" >&2; exit 1 ;;
	esac
	# It ALSO lands in a sed REPLACEMENT delimited by /, where \ and / are
	# special: a value carrying / ends the replacement and everything after
	# it is read as further sed commands, so one set on one key could rewrite
	# a different key and still exit 0. Escaping here is the opposite trade
	# to the rejection above -- it is what makes the byte stored in the file
	# the byte the operator typed.
	esc=$(printf '%s' "$val" | sed 's/[\\/]/\\&/g')

	if is_odi_key "$key"; then
		dir=$(dirname "$ODI_CONF")
		if [ ! -d "$dir" ]; then
			echo "flash: $dir is not there -- is the config partition mounted?" >&2
			exit 1
		fi
		# Temp file in the SAME directory, so the rename is one jffs2 rename
		# and a power cut leaves the old file whole. Other lines are kept
		# as they are; only this key is replaced (or dropped when empty).
		tmp="$ODI_CONF.tmp.$$"
		{
			grep -v "^$key=" "$ODI_CONF" 2>/dev/null
			[ -n "$val" ] && printf '%s=%s\n' "$key" "$val"
			true
		} > "$tmp" || { echo "flash: could not write $tmp" >&2; rm -f "$tmp"; exit 1; }
		if ! mv "$tmp" "$ODI_CONF"; then
			echo "flash: could not install the new $ODI_CONF" >&2
			rm -f "$tmp"
			exit 1
		fi
		printf '%s=%s\n' "$key" "$(odi_value_of "$key")"
		exit 0
	fi

	target=""
	for f in "$CS" "$HS"; do
		has_key "$key" "$f" && { target=$f; break; }
	done
	if [ -z "$target" ]; then
		echo "flash: no such key: $key" >&2
		exit 1
	fi

	tmp="$TMPDIR_/flash.$$"
	if ! sed "s/\(Name=\"$key\" Value=\"\)[^\"]*\"/\1$esc\"/" "$target" > "$tmp" 2>/dev/null; then
		echo "flash: could not rewrite $target" >&2
		rm -f "$tmp"
		exit 1
	fi
	# Never install an empty or truncated file over a good one -- a full
	# jffs2 partition is the realistic way this goes wrong.
	if [ ! -s "$tmp" ]; then
		echo "flash: rewrite produced an empty file, $target left alone" >&2
		rm -f "$tmp"
		exit 1
	fi
	if ! mv "$tmp" "$target"; then
		echo "flash: could not install the new $target" >&2
		rm -f "$tmp"
		exit 1
	fi
	# confd reads this line back and parses up to the = sign. printf, not
	# echo: POSIX echo expands backslash escapes, so a value holding \b
	# came back to confd with the b gone while the file held it correctly.
	printf '%s=%s\n' "$key" "$(value_of "$key" "$target")"
	;;

default)
	# Merge the image defaults into the CS file: every key the defaults
	# file names gets its default value, and every other key is left as it
	# is. /etc/config_default.xml is ours (rootfs/skeleton), ten keys:
	# DEVICE_TYPE, DUAL_MGMT_MODE, the three OMCI_CUSTOM masks and the four
	# LOID keys. So this is a reset of those, not of the whole store -- the
	# management address, the VLAN and the PLOAM password are not in the
	# defaults and survive it. That is deliberate: the partition is shared
	# with the other slot, and wiping keys this image does not even read
	# would reset the stock firmware too.
	#
	# HS is never reset. A default key that lives only in the HS file here
	# (LOID_PASSWD_OLD, on a stick that keeps it where xmlconfig puts it) is
	# left there and named, rather than a second copy inserted into CS.
	[ $# -eq 2 ] && [ "$2" = cs ] || { echo "flash: only the cs store can be reset" >&2; exit 1; }
	if [ ! -s "$DEFAULTS" ]; then
		echo "FATAL ERROR: no $DEFAULTS in this image; CS left alone." >&2
		exit 1
	fi
	if [ ! -f "$CS" ]; then
		echo "flash: $CS is not there -- is the config partition mounted?" >&2
		exit 1
	fi
	tmp="$TMPDIR_/flash.$$"
	cp "$CS" "$tmp" || { echo "flash: could not copy $CS" >&2; rm -f "$tmp"; exit 1; }
	pairs=$(sed -n "s/.*<Value Name=\"\([A-Za-z0-9_]*\)\" Value=\"\([^\"]*\)\".*/\1 \2/p" "$DEFAULTS")
	# A here-document, not a pipe: the loop has to set $failed in this shell.
	failed=0
	while read -r key val; do
		[ -n "$key" ] || continue
		if has_key "$key" "$tmp"; then
			esc=$(printf '%s' "$val" | sed 's/[\\/]/\\&/g')
			if sed "s/\(Name=\"$key\" Value=\"\)[^\"]*\"/\1$esc\"/" "$tmp" > "$tmp.n" &&
			   [ -s "$tmp.n" ] && mv "$tmp.n" "$tmp"; then
				printf '%s=%s\n' "$key" "$val"
			else
				failed=1
			fi
		elif has_key "$key" "$HS"; then
			echo "$key: kept, it is in the hs store and hs is never reset"
		else
			# Absent from both: insert it into the MIB_TABLE Dir, where
			# xmlconfig would have written it.
			if awk -v k="$key" -v v="$val" '
				{ print }
				!done && /<Dir Name="MIB_TABLE">/ {
					printf "\t\t<Value Name=\"%s\" Value=\"%s\"/>\n", k, v
					done = 1
				}
				END { exit !done }' "$tmp" > "$tmp.n" && mv "$tmp.n" "$tmp"; then
				printf '%s=%s (added)\n' "$key" "$val"
			else
				echo "flash: no MIB_TABLE in $CS to add $key to" >&2
				failed=1
			fi
		fi
	done <<EOF_PAIRS
$pairs
EOF_PAIRS
	rm -f "$tmp.n"
	if [ "$failed" = 1 ] || [ ! -s "$tmp" ]; then
		echo "FATAL ERROR: the merge failed; $CS left alone." >&2
		rm -f "$tmp"
		exit 1
	fi
	if ! mv "$tmp" "$CS"; then
		echo "flash: could not install the new $CS" >&2
		rm -f "$tmp"
		exit 1
	fi
	echo "Reset CS to default configuration success."
	;;

*)
	usage
	;;
esac
exit 0
